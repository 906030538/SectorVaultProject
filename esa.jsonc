{
  // 与 ESA 控制台的项目名对齐（同名项目自动关联；改名或删掉此字段以控制台为准）
  "name": "sector-vault-project",
  // 边缘函数单一入口（ESA 无 functions/ 目录路由，OAuth 代理契约在 entry 里实现；
  // 本文件优先级高于控制台的「函数文件路径」设置）
  "entry": "./esa/entry.js",
  "installCommand": "npm install",
  "buildCommand": "npm run build:hash",
  "assets": {
    "directory": "./dist",
    // hash 构建（build:hash）下整站收敛为 index.html 单页（# 路由，不依赖任何回退）；
    // 404.html 与 index 同壳，404Page 策略仅作为站外旧路径链接（/view/… 等）的兜底入口：
    // 兜底取到 404 页后由前端路由回退 pathname 激活（singlePageApplication 返回的
    // index.html 现与 404 页同为整站壳，两者皆可，维持 404Page 语义不变）
    "notFoundStrategy": "404Page"
  }
}