{
  "$id": "https://sector-vault.dev/schema/config.schema.json",
  "title": "Index repository configuration",
  "type": "object",
  "required": ["archiveSchedule", "maxCurrentSubmissions"],
  "properties": {
    "archiveSchedule": {
      "type": "string",
      "description": "Cron 表达式（分 时 日 月 周，UTC），控制归档任务运行周期",
      "pattern": "^([0-9*/,-]+ ){4}[0-9*/,-]+$"
    },
    "maxCurrentSubmissions": {
      "type": "integer",
      "minimum": 1,
      "description": "current.json 未归档索引的投稿条数上限，超过则裁剪最早的当月条目"
    }
  },
  "additionalProperties": false
}
