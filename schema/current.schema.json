{
  "$id": "https://sector-vault.dev/schema/current.schema.json",
  "title": "Derived current index file (generated by CI from archives)",
  "type": "object",
  "required": ["submissions", "users", "archives"],
  "properties": {
    "submissions": {
      "type": "array",
      "items": { "$ref": "submission.schema.json" }
    },
    "users": {
      "type": "array",
      "items": { "$ref": "user.schema.json" }
    },
    "archives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "submissions", "byType"],
        "properties": {
          "file": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}\\.json$" },
          "submissions": { "type": "integer", "minimum": 0 },
          "byType": {
            "type": "object",
            "required": ["project", "article"],
            "properties": {
              "project": { "type": "integer", "minimum": 0 },
              "article": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
