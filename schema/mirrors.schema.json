{
  "$id": "https://sector-vault.dev/schema/mirrors.schema.json",
  "title": "Mirror repository index",
  "type": "object",
  "propertyNames": {
    "pattern": "^[A-Za-z0-9.-]+(?:/[A-Za-z0-9._-]+){2}$"
  },
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]+(?:/[A-Za-z0-9._-]+){2}$"
    }
  }
}
