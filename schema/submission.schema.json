{
  "$id": "https://sector-vault.dev/schema/submission.schema.json",
  "title": "Submission index entry",
  "type": "object",
  "required": [
    "platform",
    "owner",
    "repo",
    "slug",
    "title",
    "submittedAt"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": ["github", "gitee", "atomgit"]
    },
    "owner": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[0-9A-Za-z_\\-\\u3041-\\u30FF\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uF900-\\uFAFF\\uAC00-\\uD7A3\\u3130-\\u318F]+$" },
    "title": { "type": "string", "minLength": 1 },
    "cover": { "type": ["string", "null"] },
    "submittedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+(Z|[+-]\\d{2}:?\\d{2})$" },
    "publishedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+(Z|[+-]\\d{2}:?\\d{2})$" },
    "issue": { "type": "integer", "minimum": 1 },
    "release": { "type": ["string", "null"], "minLength": 1 },
    "type": { "type": "string", "enum": ["project", "article"] },
    "paramState": { "type": "string", "enum": ["with-param", "tuned", "no-param"] },
    "songs": { "type": "array", "maxItems": 10, "items": { "type": "string" } },
    "engines": { "type": "array", "maxItems": 10, "items": { "type": "string" } },
    "voicebanks": { "type": "array", "maxItems": 10, "items": { "type": "string" } },
    "languages": { "type": "array", "maxItems": 10, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
