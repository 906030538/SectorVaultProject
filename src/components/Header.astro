---
import { DEFAULT_INDEX_SOURCES, SITE_NAME } from '@/config';
import { t } from '@/i18n';
import type { Locale, MessageKey } from '@/i18n';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import LineSwitcher from '@/components/LineSwitcher.astro';
import logoSmallUrl from '../../logo-small.svg?url';
import { withBase } from '@/lib/base';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = Astro.url.pathname;

const navItems: { key: MessageKey; href: string; fold: 460 | 560 | 700 | 800 | 900 }[] = [
  { key: 'nav.projects', href: withBase('/project'), fold: 460 },
  { key: 'nav.articles', href: withBase('/article'), fold: 560 },
  { key: 'nav.discussions', href: withBase('/discussions'), fold: 700 },
  { key: 'nav.faq', href: withBase('/faq'), fold: 800 },
  { key: 'nav.about', href: withBase('/about'), fold: 900 },
];

/** 各平台站点根地址（问题反馈链接拼接用） */
const WEB_BASE: Record<string, string> = {
  github: 'https://github.com',
  gitee: 'https://gitee.com',
  atomgit: 'https://atomgit.com',
  gitcode: 'https://gitcode.com',
};

/** 问题反馈：指向当前线路索引仓的 issue 列表（客户端按线路修正，此处为构建期回退值） */
const primarySource = DEFAULT_INDEX_SOURCES[0]!;
const feedbackHref = (source: { platform: string; owner: string; repo: string }): string =>
  `${WEB_BASE[source.platform] ?? 'https://github.com'}/${source.owner}/${source.repo}/issues`;

/**
 * 左导航逐项折叠（从最右项开始）：宽度低于该项阈值时，
 * 内联项隐藏、下拉面板中的对应项显示（字面量类保证被 Tailwind 扫描）。
 */
const FOLD_INLINE = {
  460: 'max-[460px]:hidden',
  560: 'max-[560px]:hidden',
  700: 'max-[700px]:hidden',
  800: 'max-[800px]:hidden',
  900: 'max-[900px]:hidden',
} as const;

const FOLD_PANEL = {
  460: 'max-[460px]:flex',
  560: 'max-[560px]:flex',
  700: 'max-[700px]:flex',
  800: 'max-[800px]:flex',
  900: 'max-[900px]:flex',
} as const;

const linkClasses = [
  'whitespace-nowrap rounded-lg px-2.5 py-1.5 text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900',
  'dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white',
];

function isActive(href: string): boolean {
  return path === href || path.startsWith(`${href}/`);
}
---

<header
  class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90"
>
  <div class="relative flex h-14 items-center gap-3 px-4">
    <a href={withBase("/")} class="flex shrink-0 items-center font-bold">
      <img src={logoSmallUrl} alt={SITE_NAME} class="h-8 w-auto" />
    </a>

    <!-- 窄屏：左侧导航折叠开关（首个左导航项折叠时出现） -->
    <button
      type="button"
      class="btn hidden px-2.5 max-[900px]:block"
      data-action="toggle-nav"
      aria-label={t(locale, 'nav.menu')}
    >
      ☰
    </button>

    <!-- 左侧导航：宽度不足时从右向左逐项折入下拉面板 -->
    <nav class="flex items-center gap-1 text-sm">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-i18n={item.key}
            class:list={[...linkClasses, FOLD_INLINE[item.fold], { 'bg-slate-100 font-medium text-slate-900 dark:bg-slate-800 dark:text-white': isActive(item.href) }]}
          >
            {t(locale, item.key)}
          </a>
        ))
      }
      <!-- 问题反馈：跳转当前线路索引仓的 issue 列表（新标签页） -->
      <a
        href={feedbackHref(primarySource)}
        data-i18n="nav.feedback"
        data-role="feedback-link"
        target="_blank"
        rel="noopener"
        class:list={[...linkClasses, FOLD_INLINE[900]]}
      >
        {t(locale, 'nav.feedback')}
      </a>
    </nav>

    <!-- 左侧导航下拉面板（内容与内联项互补显隐，JS 切换整体开合） -->
    <div
      class="absolute inset-x-0 top-14 z-40 hidden flex-col gap-1 border-b border-slate-200 bg-white p-3 text-sm shadow-lg dark:border-slate-800 dark:bg-slate-950"
      data-role="nav-menu"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-i18n={item.key}
            class:list={['hidden', ...linkClasses, FOLD_PANEL[item.fold], { 'bg-slate-100 font-medium text-slate-900 dark:bg-slate-800 dark:text-white': isActive(item.href) }]}
          >
            {t(locale, item.key)}
          </a>
        ))
      }
      <a
        href={feedbackHref(primarySource)}
        data-i18n="nav.feedback"
        data-role="feedback-link"
        target="_blank"
        rel="noopener"
        class:list={['hidden', ...linkClasses, FOLD_PANEL[900]]}
      >
        {t(locale, 'nav.feedback')}
      </a>
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <!-- 宽度不足：右导航先折叠为下拉开关 -->
      <button
        type="button"
        class="btn px-2.5 lg:hidden"
        data-action="toggle-controls"
        aria-label={t(locale, 'nav.more')}
      >
        ⋯
      </button>

      <!-- 右侧控件：桌面行内展开，不足时折叠为下拉面板（JS 切换 hidden） -->
      <div
        class="absolute right-0 top-14 z-40 hidden flex-col items-start gap-2 rounded-b-lg border-b border-slate-200 bg-white p-3 shadow-lg dark:border-slate-800 dark:bg-slate-950 lg:static lg:flex lg:flex-row lg:items-center lg:gap-2 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none"
        data-role="controls-menu"
      >
        <a href={withBase("/new")} class="btn btn-primary" data-role="nav-submit" data-i18n="nav.submit">
          {t(locale, 'nav.submit')}
        </a>
        <LineSwitcher />
        <LanguageSwitcher locale={locale} />
        <ThemeToggle locale={locale} />
        <div id="user-area" class="flex items-center gap-2 text-sm">
          <button class="btn" type="button" data-i18n="nav.login">{t(locale, 'nav.login')}</button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { openAuthDialog } from '@/lib/auth-dialog';
  import { buildAuthLabels } from '@/lib/labels';
  import { getClientLocale } from '@/lib/i18n-client';
  import { loadSession, loadSessionBy, logoutPlatform, syncAuthToCookies } from '@/lib/auth';
  import { getLineSources, getStoredLine } from '@/lib/index/sources';
  import { t } from '@/i18n';
  import { setAvatar } from '@/lib/ui';
  import { withBase } from '@/lib/base';
  import { SUPPORTED_PLATFORMS } from '@/config';
  import type { Platform } from '@/types';

  // 既有登录态迁移：localStorage 有而父域 cookie 缺失时补写（供兄弟子域共享）
  syncAuthToCookies();

  // 问题反馈链接：按当前线路的索引仓修正 issue 列表地址（构建期为默认线路）
  const WEB_BASE_CLIENT: Record<Platform, string> = {
    github: 'https://github.com',
    gitee: 'https://gitee.com',
    atomgit: 'https://atomgit.com',
    gitcode: 'https://gitcode.com',
  };
  void getLineSources().then((sources) => {
    const source = sources[0]!;
    const target = `${WEB_BASE_CLIENT[source.platform] ?? 'https://github.com'}/${source.owner}/${source.repo}/issues`;
    for (const link of Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-role="feedback-link"]'))) {
      link.href = target;
    }
  });

  // 已登录时以头像 + 用户名替换登录按钮（登录态保存在 localStorage）。
  // 已选线路时按线路平台取会话：该平台未登录则保留登录按钮（弹窗预选该平台）；
  // 未选线路时回退最近一次登录。
  const storedLine = getStoredLine();
  const linePlatform = SUPPORTED_PLATFORMS.includes(storedLine as Platform)
    ? (storedLine as Platform)
    : null;
  const preferred = linePlatform === 'gitcode' ? null : linePlatform;
  let session: { login?: string; name?: string; avatarUrl?: string } | null = null;
  const area = document.getElementById('user-area');
  if (area) {
    session = linePlatform ? loadSessionBy(linePlatform) : loadSession();
    try {
      if (session?.login) {
        area.textContent = '';
        const link = document.createElement('a');
        link.href = withBase(`/user/${encodeURIComponent(session.login)}`);
        link.className = 'flex items-center gap-2';
        if (session.avatarUrl) {
          const img = document.createElement('img');
          setAvatar(img, session.avatarUrl);
          img.alt = session.login;
          img.className = 'h-7 w-7 rounded-full';
          link.appendChild(img);
        }
        const name = document.createElement('span');
        name.textContent = session.name ?? session.login;
        link.appendChild(name);
        area.appendChild(link);
        // 登出：仅清除当前线路平台的令牌与会话（其他线路登录态保留）后刷新
        const logoutBtn = document.createElement('button');
        logoutBtn.type = 'button';
        logoutBtn.className = 'btn px-2.5';
        logoutBtn.dataset.action = 'logout';
        logoutBtn.dataset.i18n = 'nav.logout';
        logoutBtn.textContent = t(getClientLocale(), 'nav.logout');
        logoutBtn.addEventListener('click', () => {
          void (async () => {
            for (const platform of [...new Set((await getLineSources()).map((s) => s.platform))]) {
              logoutPlatform(platform);
            }
            window.location.reload();
          })();
        });
        area.appendChild(logoutBtn);
      }
    } catch {
      /* 忽略损坏的会话数据 */
    }
    const loginBtn = area.querySelector('button');
    if (loginBtn) {
      loginBtn.addEventListener('click', () => {
        void openAuthDialog(buildAuthLabels(getClientLocale()), preferred ?? undefined);
      });
    }
  }

  // 导航栏投稿按钮：已登录跳转新建投稿页，未登录与登录按钮一致（打开授权对话框）
  const submitLink = document.querySelector<HTMLAnchorElement>('[data-role="nav-submit"]');
  if (submitLink && !loadSession()?.login) {
    submitLink.addEventListener('click', (event) => {
      event.preventDefault();
      void openAuthDialog(buildAuthLabels(getClientLocale()), preferred ?? undefined);
    });
  }

  // 窄屏折叠面板：左右独立开合，互斥；点击面板外或 Escape 关闭
  const navMenu = document.querySelector<HTMLElement>('[data-role="nav-menu"]');
  const controlsMenu = document.querySelector<HTMLElement>('[data-role="controls-menu"]');
  const closeMenus = (): void => {
    navMenu?.classList.add('hidden');
    controlsMenu?.classList.add('hidden');
  };
  for (const [action, panel] of [
    ['toggle-nav', navMenu],
    ['toggle-controls', controlsMenu],
  ] as const) {
    document.querySelector(`[data-action="${action}"]`)?.addEventListener('click', (event) => {
      event.stopPropagation();
      if (!panel) return;
      const wasOpen = !panel.classList.contains('hidden');
      closeMenus();
      if (!wasOpen) panel.classList.remove('hidden');
    });
  }
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('header')) closeMenus();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenus();
  });

  // OAuth 回退入口：/?auth=1 自动打开授权对话框（在监听器就绪后触发）
  if (new URLSearchParams(window.location.search).get('auth') === '1') {
    window.history.replaceState(null, '', window.location.pathname);
    void openAuthDialog(buildAuthLabels(getClientLocale()), preferred ?? undefined);
  }
</script>
