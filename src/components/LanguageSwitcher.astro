---
import { LOCALES } from '@/i18n';
import type { Locale } from '@/i18n';
import { t } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!-- 语言选择：翻译图标按钮 + 下拉（点击展开，选择后整页重载重译） -->
<div class="relative" data-role="lang-switcher">
  <button
    type="button"
    id="lang-switcher"
    class="btn h-8 px-2.5"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={t(locale, 'nav.language')}
    data-i18n-aria="nav.language"
    title={t(locale, 'nav.language')}
  >
    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true"><path d="m12.87 15.07-2.54-2.51.03-.03A17.52 17.52 0 0014.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7 1.62-4.33L19.12 17h-3.24z"/></svg>
    <svg viewBox="0 0 24 24" width="0.75em" height="0.75em" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  <div
    class="absolute right-0 z-40 mt-1 hidden w-40 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900"
    data-role="lang-menu"
    role="listbox"
    aria-label={t(locale, 'nav.language')}
  ></div>
</div>

<script>
  import { LOCALES } from '@/i18n';
  import { getClientLocale, LOCALE_STORAGE_KEY } from '@/lib/i18n-client';

  // 语言偏好保存在 localStorage（不体现在路由中），切换后整页重载以重译全部内容
  const root = document.querySelector('[data-role="lang-switcher"]');
  const button = root?.querySelector<HTMLButtonElement>('#lang-switcher') ?? null;
  const menu = root?.querySelector<HTMLElement>('[data-role="lang-menu"]') ?? null;

  if (root && button && menu) {
    button.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      button.setAttribute('aria-expanded', String(!open));
    });
    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) {
        menu.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
      }
    });

    const current = getClientLocale();
    for (const item of LOCALES) {
      const option = document.createElement('button');
      option.type = 'button';
      option.className =
        'block w-full px-3 py-2 text-left text-sm hover:bg-slate-100 dark:hover:bg-slate-800';
      option.setAttribute('role', 'option');
      option.dataset.lang = item.code;
      option.textContent = item.label;
      if (item.code === current) {
        option.classList.add('bg-emerald-50', 'font-medium', 'dark:bg-emerald-950/40');
        option.setAttribute('aria-selected', 'true');
      }
      option.addEventListener('click', () => {
        if (item.code === current) return;
        localStorage.setItem(LOCALE_STORAGE_KEY, item.code);
        location.reload();
      });
      menu.appendChild(option);
    }
  }
</script>
