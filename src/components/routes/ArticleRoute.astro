---
import LoadingBlock from '@/components/LoadingBlock.astro';
import Pagination from '@/components/Pagination.astro';
import { PAGE_SIZE } from '@/config';
import { DEFAULT_LOCALE, t } from '@/i18n';

/**
 * /article 文章列表路由（hash 模式挂在 index 单页壳上，path 模式直接渲染在 /article 页）。
 * 列表数据、搜索与翻页全部客户端完成；分页大小经根节点 dataset 下发。
 */
const locale = DEFAULT_LOCALE;
---

<div data-route-component="article" data-page-size={PAGE_SIZE}>
  <h1 class="mb-6 text-2xl font-bold" data-i18n="article.title">{t(locale, 'article.title')}</h1>

  <div class="mb-4 flex items-center gap-2">
    <input
      type="search"
      class="input w-56"
      data-role="search-input"
      placeholder={t(locale, 'project.searchPlaceholder')}
      data-i18n-ph="project.searchPlaceholder"
    />
    <button type="button" class="btn btn-primary" data-action="search" data-i18n="common.search">
      {t(locale, 'common.search')}
    </button>
  </div>

  <div class="flex flex-col gap-3" data-component="list"></div>
  <p class="py-8 text-center text-slate-400" data-role="empty" data-i18n="common.noResults" hidden>
    {t(locale, 'common.noResults')}
  </p>
  <LoadingBlock locale={locale} />
  <Pagination locale={locale} />
</div>

<script>
  import { registerRoute } from '@/lib/router';
  import { iterateAllSubmissions } from '@/lib/index/loader';
  import { renderCard } from '@/lib/ui';
  import { buildCardLabels } from '@/lib/labels';
  import { getClientLocale } from '@/lib/i18n-client';
  import { t } from '@/i18n';
  import { SITE_NAME } from '@/config';
  import type { SubmissionEntry } from '@/types';

  registerRoute(async (loc) => {
    const segments = loc.path.split('/').filter(Boolean);
    if (segments[0] !== 'article' || segments.length > 1) return;
    const root = document.querySelector<HTMLElement>('[data-route-component="article"]');
    if (!root) return;
    const host = root.closest<HTMLElement>('[data-route-host]');
    if (host) host.hidden = false;
    document.querySelector('[data-role="not-found"]')?.setAttribute('hidden', '');
    document.title = `${t(getClientLocale(), 'article.title')} - ${SITE_NAME}`;

    const locale = getClientLocale();
    const labels = buildCardLabels(locale);
    const config = { pageSize: Number(root.dataset.pageSize) || 20 };

    const listEl = root.querySelector('[data-component="list"]')!;
    const emptyEl = root.querySelector<HTMLElement>('[data-role="empty"]')!;
    const loadingEl = root.querySelector<HTMLElement>('[data-component="loading"]')!;
    const pageInfo = root.querySelector<HTMLElement>('[data-role="page-info"]')!;
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-action="prev"]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-action="next"]')!;
    const cancelBtn = root.querySelector<HTMLButtonElement>('[data-action="cancel"]')!;
    const searchInput = root.querySelector<HTMLInputElement>('[data-role="search-input"]')!;
    const searchBtn = root.querySelector<HTMLButtonElement>('[data-action="search"]')!;

    let filtered: SubmissionEntry[] = [];
    let page = 0;
    let keyword = '';

    function applyAndRender(): void {
      page = 0;
      renderPage();
    }

    function renderPage(): void {
      let visible = filtered;
      if (keyword) {
        const kw = keyword.toLowerCase();
        visible = visible.filter((e) =>
          `${e.title} ${e.owner}`.toLowerCase().includes(kw),
        );
      }
      const totalPages = Math.max(1, Math.ceil(visible.length / config.pageSize));
      page = Math.min(page, totalPages - 1);
      const slice = visible.slice(page * config.pageSize, (page + 1) * config.pageSize);

      listEl.textContent = '';
      for (const entry of slice)
        listEl.appendChild(renderCard(entry, locale, labels, { compact: true }));
      emptyEl.hidden = slice.length > 0;
      pageInfo.textContent = `${page + 1} / ${totalPages}`;
      prevBtn.disabled = page === 0;
      nextBtn.disabled = page >= totalPages - 1;
    }

    prevBtn.addEventListener('click', () => {
      page -= 1;
      renderPage();
    });
    nextBtn.addEventListener('click', () => {
      page += 1;
      renderPage();
    });
    searchBtn.addEventListener('click', () => {
      keyword = searchInput.value.trim();
      applyAndRender();
    });
    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') searchBtn.click();
    });
    cancelBtn.addEventListener('click', () => {
      loadingEl.hidden = true;
    });

    loadingEl.hidden = false;
    try {
      const all: SubmissionEntry[] = [];
      for await (const entry of iterateAllSubmissions()) {
        if (entry.type === 'article') all.push(entry);
      }
      filtered = all.sort((a, b) => b.submittedAt.localeCompare(a.submittedAt));
      applyAndRender();
    } catch {
      emptyEl.hidden = false;
    } finally {
      loadingEl.hidden = true;
    }
  });
</script>
