---
import Pagination from '@/components/Pagination.astro';
import { DEFAULT_LOCALE, t } from '@/i18n';

/**
 * /view/:user/:repo 与 /view/:user/:repo/:slug 的路由组件。
 * 配置完全由客户端解析 window.location.pathname 得到，
 * 因此同一组件既用于静态预渲染页，也用于 404 SPA 回退。
 */
const locale = DEFAULT_LOCALE;
---

<div data-route-component="view">
  {
    /* 集合详情或稿件详情：客户端按段数区分（2 段 = 集合，3 段起 = 稿件） */
  }
  <article class="mx-auto hidden w-full max-w-3xl lg:max-w-6xl lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start lg:gap-8" data-view-skeleton="detail">
    <div class="min-w-0 lg:row-start-1">
      <header>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-3xl font-bold" data-role="title"></h1>
          <span class="ml-auto flex gap-2" data-role="detail-actions"></span>
        </div>
        <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400" data-role="date-row">
          <span data-role="date">–</span>
          <span data-role="engagement"></span>
        </div>
        <div class="mt-4" data-role="meta"></div>
      </header>

      <section class="prose-svp mt-8" data-role="body"></section>

      <div class="mt-6 flex flex-wrap gap-2" data-role="tags"></div>

      <section class="mt-8" data-role="media-section">
        <h2 class="mb-3 text-lg font-semibold" data-i18n="detail.media">
          {t(locale, 'detail.media')}
        </h2>
        <div data-role="media"></div>
      </section>
    </div>

    <!-- 右侧栏（宽屏）：作者 / 工程文件 / 关联 release；窄屏时依次排在主列之后 -->
    <aside class="flex flex-col gap-6 lg:sticky lg:top-20 lg:col-start-2 lg:row-start-1">
      <section class="card flex items-center gap-3 p-4" data-role="author">
        <span class="text-sm text-slate-400" data-role="author-path"></span>
      </section>

      <section class="mt-8 lg:mt-0">
        <h2 class="mb-3 text-lg font-semibold" data-i18n="detail.files">
          {t(locale, 'detail.files')}
        </h2>
        <div data-role="files"></div>
      </section>

      <section class="mt-8 lg:mt-0">
        <div class="mb-3 flex items-center gap-2">
          <h2 class="text-lg font-semibold" data-i18n="detail.release">
            {t(locale, 'detail.release')}
          </h2>
          <a class="btn ml-auto hidden px-2.5 py-1 text-xs" data-role="release-goto" target="_blank" rel="noopener"></a>
        </div>
        <div data-role="release"></div>
      </section>
    </aside>

    <!-- 留言区：宽屏回到左列（第二行），窄屏位于最底 -->
    <section class="mt-8 lg:col-start-1 lg:row-start-2">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="text-lg font-semibold" data-i18n="detail.comments">
          {t(locale, 'detail.comments')}
        </h2>
        <a class="btn ml-auto hidden px-2.5 py-1 text-xs" data-role="issue-goto" target="_blank" rel="noopener"></a>
      </div>
      <div data-role="issues"></div>
    </section>
  </article>

  <div class="hidden" data-view-skeleton="collection">
    <header class="mb-6">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold" data-role="repo-name"></h1>
        <div class="ml-auto flex gap-2" data-role="actions"></div>
      </div>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400" data-role="repo-meta"></p>
    </header>

    <div class="mb-4 flex gap-2" data-role="tabs">
      <button type="button" class="btn btn-primary" data-tab="project" data-i18n="type.project">
        {t(locale, 'type.project')}
      </button>
      <button type="button" class="btn" data-tab="article" data-i18n="type.article">
        {t(locale, 'type.article')}
      </button>
    </div>

    <div class="flex flex-col gap-3" data-component="list"></div>
    <p
      class="py-8 text-center text-slate-400"
      data-role="empty"
      data-i18n="common.noResults"
      hidden
    >
      {t(locale, 'common.noResults')}
    </p>
    <Pagination locale={locale} />
  </div>
</div>

<script>
  import { stripBase } from '@/lib/base';
  import { initCollection } from '@/lib/views/collection';
  import { initDetail } from '@/lib/views/detail';
  import { buildCollectionLabels, buildDetailLabels } from '@/lib/labels';
  import { getClientLocale } from '@/lib/i18n-client';
  import { SITE_NAME } from '@/config';
  import { findPlatformForRepo, findEntry } from '@/lib/index/loader';
  import { getStoredLine, setStoredLine } from '@/lib/index/sources';
  import type { Platform } from '@/types';

void (async () => {
  // 路由匹配：/view/:user/:repo[/:slug...]；pathname 中中文为百分号编码，需逐段解码
  const segments = stripBase(window.location.pathname)
    .split('/')
    .filter(Boolean)
    .map((part) => {
      try {
        return decodeURIComponent(part);
      } catch {
        return part;
      }
    });
  const user = segments[1];
  const repo = segments[2];
  const slug = segments.slice(3).join('/');
  if (segments[0] === 'view' && user && repo) {
    const root = document.querySelector<HTMLElement>('[data-route-component="view"]')!;
    // SPA 回退：显示宿主容器并隐藏 404 内容（静态预渲染页无宿主容器）
    const host = root.closest<HTMLElement>('[data-route-host]');
    if (host) host.hidden = false;
    document.querySelector<HTMLElement>('[data-role="not-found"]')?.setAttribute('hidden', '');

    const locale = getClientLocale();
    const pick = <T extends HTMLElement>(role: string) =>
      root.querySelector<T>(`[data-role="${role}"]`)!;

    // 线路自动切换：当前线路平台没有该仓库时，切到索引记录的平台线路并重载
    const line = getStoredLine();
    if (line) {
      try {
        const located = slug
          ? ((await findEntry(user, repo, slug))?.platform ?? null)
          : await findPlatformForRepo(user, repo);
        if (located && located !== line) {
          setStoredLine(located as Platform);
          window.location.reload();
          return;
        }
      } catch {
        /* 定位失败时按当前线路渲染 */
      }
    }

    try {
      if (slug) {
        document.title = `${slug} · ${repo} - ${SITE_NAME}`;
        root.querySelector<HTMLElement>('[data-view-skeleton="detail"]')!.classList.remove('hidden');
        pick('author-path').textContent = `${user}/${repo}`;
        await initDetail({
          user,
          repo,
          slug,
          locale,
          labels: buildDetailLabels(locale),
          els: {
            title: pick('title'),
            actions: pick('detail-actions'),
            date: pick('date'),
            engagement: pick('engagement'),
            meta: pick('meta'),
            body: pick('body'),
            tags: pick('tags'),
            media: pick('media'),
            author: pick('author'),
            files: pick('files'),
            release: pick('release'),
            releaseGoto: root.querySelector<HTMLAnchorElement>('[data-role="release-goto"]')!,
            issues: pick('issues'),
            issueGoto: root.querySelector<HTMLAnchorElement>('[data-role="issue-goto"]')!,
          },
        });
      } else {
        document.title = `${repo} - ${SITE_NAME}`;
        root.querySelector<HTMLElement>('[data-view-skeleton="collection"]')!.classList.remove('hidden');
        await initCollection({
          user,
          repo,
          locale,
          labels: buildCollectionLabels(locale),
          els: {
            repoName: pick('repo-name'),
            meta: pick('repo-meta'),
            actions: pick('actions'),
            tabs: pick('tabs'),
            list: root.querySelector('[data-component="list"]')!,
            empty: pick('empty'),
            pageInfo: root.querySelector('[data-role="page-info"]')!,
            prev: root.querySelector<HTMLButtonElement>('[data-action="prev"]')!,
            next: root.querySelector<HTMLButtonElement>('[data-action="next"]')!,
          },
        });
      }
    } catch (error) {
      console.error('[view] init failed:', error);
    }
  }
})();
</script>
