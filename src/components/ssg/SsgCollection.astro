---
import { DEFAULT_LOCALE, t } from '@/i18n';
import { ssgCards, ssgRepoUrl } from '@/lib/build/ssg';
import type { SubmissionEntry } from '@/types';

/**
 * SSG 集合详情（/view/:user/:repo）：该内容仓全部投稿构建期渲染。
 */
const { user, repo, entries } = Astro.props;
const locale = DEFAULT_LOCALE;
const sorted = [...entries].sort((a, b) => b.submittedAt.localeCompare(a.submittedAt));
const owner = sorted[0]?.owner ?? user;
const platform = sorted[0]?.platform;
---

<header class="mb-6">
  <div class="flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-bold">{repo}</h1>
    <div class="ml-auto flex gap-2">
      {platform && (
        <a href={ssgRepoUrl(platform, owner, repo)} target="_blank" rel="noopener" class="btn">
          {t(locale, 'discussions.open')} ↗
        </a>
      )}
    </div>
  </div>
  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
    <a href={`/user/${owner}`} class="hover:text-emerald-600 dark:hover:text-emerald-400">{owner}</a>
    <span class="mx-1.5">·</span>
    {sorted.length} {t(locale, 'home.submissionCount')}
  </p>
</header>

{
  sorted.length > 0 ? (
    <div class="flex flex-col gap-3" set:html={ssgCards(sorted)} />
  ) : (
    <p class="py-8 text-center text-slate-400" data-i18n="common.noResults">
      {t(locale, 'common.noResults')}
    </p>
  )
}
