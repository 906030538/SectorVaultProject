---
import { SITE_NAME } from '@/config';
import { DEFAULT_LOCALE, t } from '@/i18n';
import { ssgCards, ssgIndex } from '@/lib/build/ssg';

/**
 * SSG 首页：统计与最新投稿构建期固化（SEO 可读），无运行期数据请求。
 * hero 文案与 HomeRoute 一致。
 */
const locale = DEFAULT_LOCALE;
const index = await ssgIndex();
const submissions = [...index.submissions].sort((a, b) =>
  b.submittedAt.localeCompare(a.submittedAt),
);
const latest = submissions.slice(0, 5);
const userCount = new Set(index.submissions.map((s) => s.owner)).size;
---

<section class="py-12 text-center">
  <h1 class="text-4xl font-bold tracking-tight">{SITE_NAME}</h1>
  <p class="mt-3 text-lg text-slate-500 dark:text-slate-400" data-i18n="home.hero">
    {t(locale, 'home.hero')}
  </p>
  <p class="mt-2 text-sm text-slate-400 dark:text-slate-500" data-i18n="home.tagline">
    {t(locale, 'home.tagline')}
  </p>
  <p class="mx-auto mt-6 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-300" data-i18n="home.intro">
    {t(locale, 'home.intro')}
  </p>
  <div class="mt-8 flex items-center justify-center gap-3">
    <a href="/project" class="btn btn-primary" data-i18n="nav.projects">{t(locale, 'nav.projects')}</a>
    <a href="/about" class="btn" data-i18n="nav.about">{t(locale, 'nav.about')}</a>
  </div>
</section>

<section class="mx-auto grid max-w-3xl grid-cols-2 gap-4 text-center">
  <div class="card p-6">
    <div class="text-3xl font-bold text-emerald-600 dark:text-emerald-400">
      {submissions.length}
    </div>
    <div class="mt-1 text-sm text-slate-500 dark:text-slate-400" data-i18n="home.submissionCount">
      {t(locale, 'home.submissionCount')}
    </div>
  </div>
  <div class="card p-6">
    <div class="text-3xl font-bold text-emerald-600 dark:text-emerald-400">{userCount}</div>
    <div class="mt-1 text-sm text-slate-500 dark:text-slate-400" data-i18n="home.userCount">
      {t(locale, 'home.userCount')}
    </div>
  </div>
</section>

<section class="mt-12">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-xl font-semibold" data-i18n="home.latest">{t(locale, 'home.latest')}</h2>
    <a href="/project" class="text-sm text-emerald-600 hover:underline dark:text-emerald-400">
      <span data-i18n="home.viewAll">{t(locale, 'home.viewAll')}</span> →
    </a>
  </div>
  <div class="flex flex-col gap-3" set:html={ssgCards(latest)} />
</section>
