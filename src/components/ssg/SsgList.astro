---
import { DEFAULT_LOCALE, t } from '@/i18n';
import type { SubmissionEntry } from '@/types';
import { ssgCards } from '@/lib/build/ssg';

/**
 * SSG 列表页（工程/专栏共用）：构建期渲染全部稿件卡片（SEO 可读、无运行期请求）。
 * 数据固化到构建时刻——新投稿经重新构建出现。
 */
interface Props {
  /** 列表标题 i18n key */
  titleKey: 'project.title' | 'article.title';
  entries: SubmissionEntry[];
  compact?: boolean;
}

const { titleKey, entries, compact = false } = Astro.props;
const locale = DEFAULT_LOCALE;
const sorted = [...entries].sort((a, b) => b.submittedAt.localeCompare(a.submittedAt));
---

<h1 class="mb-6 text-2xl font-bold" data-i18n={titleKey}>{t(locale, titleKey)}</h1>

{
  sorted.length > 0 ? (
    <div class="flex flex-col gap-3" set:html={ssgCards(sorted, { compact })} />
  ) : (
    <p class="py-8 text-center text-slate-400" data-i18n="common.noResults">
      {t(locale, 'common.noResults')}
    </p>
  )
}
