---
import { DEFAULT_LOCALE, t } from '@/i18n';
import { ssgCards, ssgIndex } from '@/lib/build/ssg';

/**
 * SSG 用户主页（/user/:name）：索引 users 记录 + 名下全部投稿按内容仓分组，
 * 全部构建期渲染。
 */
const { name } = Astro.props;
const locale = DEFAULT_LOCALE;

const index = await ssgIndex();
const record = index.users.find(
  (u) => u.owner === name && (u.repos ?? []).length > 0,
);
const mine = index.submissions
  .filter((s) => s.owner === name)
  .sort((a, b) => b.submittedAt.localeCompare(a.submittedAt));

// 按内容仓分组（保持投稿时间倒序的仓序）
const groups: { repo: string; entries: typeof mine }[] = [];
for (const entry of mine) {
  const group = groups.find((g) => g.repo === entry.repo);
  if (group) group.entries.push(entry);
  else groups.push({ repo: entry.repo, entries: [entry] });
}
const displayName = record?.displayName ?? name;
---

<div>
  <div class="mb-6 flex flex-wrap items-center gap-4">
    <div
      class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-200 text-2xl font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400"
    >
      {displayName.charAt(0).toUpperCase()}
    </div>
    <div>
      <h1 class="text-2xl font-bold">{displayName}</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400" data-i18n="user.title">
        {t(locale, 'user.title')}
      </p>
    </div>
    {record?.pagesUrl && (
      <a href={record.pagesUrl} target="_blank" rel="noopener" class="btn ml-auto">↗</a>
    )}
  </div>

  <section>
    <h2 class="mb-4 border-l-4 border-emerald-600 pl-3 text-xl font-semibold" data-i18n="user.projects">
      {t(locale, 'user.projects')}
    </h2>
    {
      groups.length > 0 ? (
        <div class="flex flex-col gap-6">
          {groups.map((group) => (
            <div>
              <a
                href={`/view/${name}/${group.repo}`}
                class="mb-3 inline-block font-medium hover:text-emerald-600 dark:hover:text-emerald-400"
              >
                {name}/{group.repo}
                <span class="ml-2 text-sm text-slate-400">{group.entries.length}</span>
              </a>
              <div class="flex flex-col gap-3" set:html={ssgCards(group.entries, { compact: true })} />
            </div>
          ))}
        </div>
      ) : (
        <p class="py-8 text-center text-slate-400" data-i18n="common.noResults">
          {t(locale, 'common.noResults')}
        </p>
      )
    }
  </section>
</div>
