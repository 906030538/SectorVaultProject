---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SubmissionRoute from '@/components/routes/SubmissionRoute.astro';
import CollectionRoute from '@/components/routes/CollectionRoute.astro';
import UserRoute from '@/components/routes/UserRoute.astro';
import EditRoute from '@/components/routes/EditRoute.astro';
import DiscussionRoute from '@/components/routes/DiscussionRoute.astro';
import LoginRoute from '@/components/routes/LoginRoute.astro';
import { SITE_NAME } from '@/config';
import { withBase } from '@/lib/base';
---

<BaseLayout title="404">
  <div class="py-24 text-center" data-role="not-found">
    <p class="text-6xl font-bold text-slate-200 dark:text-slate-800">404</p>
    <a href={withBase("/")} class="btn btn-primary mt-6">
      ← {SITE_NAME}
    </a>
  </div>

  <!--
    SPA 回退：静态托管对未知路径返回本页，各路由组件按 window.location
    自行判断是否激活（匹配则显示宿主容器并隐藏 404 内容），
    使索引尚未收录（或构建后才新增）的 /view、/user、/edit 路径可直接访问。
  -->
  <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
    // 命中 SPA 路由前缀时预先隐藏 404 与返回按钮（模块脚本加载前即生效，避免闪现）；
    // 若超时后仍无路由组件激活（路径不合法等），恢复显示 404
    (function () {
      var path = window.location.pathname;
      if (base && base !== '/' && path.indexOf(base) === 0) path = path.slice(base.length);
      var first = path.split('/').filter(Boolean)[0];
      if (!first || ['view', 'user', 'edit', 'discussions', 'login'].indexOf(first) === -1) return;
      var notice = document.querySelector('[data-role="not-found"]');
      if (notice) notice.setAttribute('hidden', '');
      setTimeout(function () {
        var active = Array.prototype.some.call(
          document.querySelectorAll('[data-route-host]'),
          function (host) {
            return !host.hidden && host.getBoundingClientRect().height > 0;
          },
        );
        if (!active && notice) notice.removeAttribute('hidden');
      }, 2500);
    })();
  </script>
  <div hidden data-route-host="submission"><SubmissionRoute /></div>
  <div hidden data-route-host="collection"><CollectionRoute /></div>
  <div hidden data-route-host="user"><UserRoute /></div>
  <div hidden data-route-host="edit"><EditRoute /></div>
  <div hidden data-route-host="discussion"><DiscussionRoute /></div>
  <div hidden data-route-host="login"><LoginRoute /></div>
</BaseLayout>
