---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutRoute from "@/components/routes/AboutRoute.astro";
import HashRedirect from "@/components/HashRedirect.astro";
import { HASH_ROUTER } from "@/lib/router";
---

{
  HASH_ROUTER ? (
    <HashRedirect to="/about" />
  ) : (
    <BaseLayout titleKey="about.title">
      <AboutRoute />
    </BaseLayout>
  )
}
