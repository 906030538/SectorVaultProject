---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MAIN_REPO } from '@/config';
import { DEFAULT_LOCALE, t } from '@/i18n';

const locale = DEFAULT_LOCALE;
const discussionsUrl = `https://github.com/${MAIN_REPO.owner}/${MAIN_REPO.name}/discussions`;
---

<BaseLayout titleKey="discussions.title">
  <h1 class="mb-6 text-2xl font-bold" data-i18n="discussions.title">
    {t(locale, 'discussions.title')}
  </h1>
  <div class="card p-8 text-center">
    <p class="text-slate-600 dark:text-slate-300" data-i18n="discussions.description">
      {t(locale, 'discussions.description')}
    </p>
    <a href={discussionsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-6">
      <span data-i18n="discussions.open">{t(locale, 'discussions.open')}</span> →
    </a>
    <!-- TODO: 登录态下嵌入主站点仓库 Discussions 列表与楼层 -->
  </div>
</BaseLayout>
