---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DiscussionsRoute from '@/components/routes/DiscussionsRoute.astro';
import HashRedirect from '@/components/HashRedirect.astro';
import { HASH_ROUTER } from '@/lib/router';
---

{
  HASH_ROUTER ? (
    <HashRedirect to="/discussions" />
  ) : (
    <BaseLayout titleKey="discussions.title">
      <DiscussionsRoute />
    </BaseLayout>
  )
}
