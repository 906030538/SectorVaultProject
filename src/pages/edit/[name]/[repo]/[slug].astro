---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EditRoute from '@/components/routes/EditRoute.astro';
import { editStaticPaths } from '@/lib/paths';

/**
 * 动态路由 /edit/:name/:repo/:slug。
 * 索引内已知稿件构建期预渲染；其余稿件由 404 SPA 回退客户端渲染。
 */
export async function getStaticPaths() {
  return await editStaticPaths();
}
---

<BaseLayout>
  <EditRoute />
</BaseLayout>
