---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EditRoute from '@/components/routes/EditRoute.astro';

/**
 * 动态路由 /edit/:name/:repo/:slug。
 * 不做构建期预渲染（避免按稿件生成具体页面），全部由 404 SPA 回退客户端渲染。
 */
export function getStaticPaths() {
  return [];
}
---

<BaseLayout>
  <EditRoute />
</BaseLayout>
