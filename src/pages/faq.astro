---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_INDEX_SOURCES } from '@/config';
import { DEFAULT_LOCALE, t } from '@/i18n';

const locale = DEFAULT_LOCALE;
const primary = DEFAULT_INDEX_SOURCES[0];
---

<BaseLayout titleKey="faq.title">
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-bold" data-i18n="faq.title">{t(locale, 'faq.title')}</h1>
    <a
      href={`https://github.com/${primary.owner}/${primary.repo}/wiki`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn ml-auto"
      data-role="source-btn"
    >
      <span data-i18n="faq.viewSource">{t(locale, 'faq.viewSource')}</span> ↗
    </a>
  </div>
  <p class="mb-4 text-slate-500 dark:text-slate-400" data-i18n="faq.description">
    {t(locale, 'faq.description')}
  </p>

  <!-- 目录：页面列表来自 deployment.json 的 faqPages（缺省内置列表），点击站内加载 -->
  <nav class="mb-4 flex flex-wrap gap-2" data-role="faq-toc" aria-label={t(locale, 'faq.toc')}>
  </nav>

  <p class="hidden py-8 text-center text-rose-500" data-role="faq-error" data-i18n="faq.loadError">
    {t(locale, 'faq.loadError')}
  </p>
  <div class="card prose-svp p-6" data-role="faq-body"></div>

  <script>
    import { loadFaqPage } from '@/lib/views/faq';
    import { getFaqPages } from '@/lib/index/sources';
    import { getClientLocale } from '@/lib/i18n-client';
    import { t } from '@/i18n';
    import { withBase } from '@/lib/base';

    const locale = getClientLocale();
    let current = new URLSearchParams(window.location.search).get('page') || 'Home';

    const init = {
      owner: '906030538',
      repo: 'SectorVaultProject',
      labels: {
        viewSource: t(locale, 'faq.viewSource'),
        loadError: t(locale, 'faq.loadError'),
        empty: t(locale, 'faq.empty'),
      },
      els: {
        body: document.querySelector<HTMLElement>('[data-role="faq-body"]')!,
        sourceBtn: document.querySelector<HTMLAnchorElement>('[data-role="source-btn"]')!,
        error: document.querySelector<HTMLElement>('[data-role="faq-error"]')!,
      },
    };

    // 目录：当前页高亮，点击无刷新切换
    const toc = document.querySelector('[data-role="faq-toc"]');
    const homeLabel = t(locale, 'faq.home');
    const renderToc = (pages: string[]): void => {
      if (!toc) return;
      toc.textContent = '';
      for (const page of pages) {
        const link = document.createElement('a');
        link.href = withBase(`/faq?page=${encodeURIComponent(page)}`);
        link.className = 'chip';
        link.textContent = page === 'Home' ? homeLabel : page;
        link.dataset.page = page;
        link.addEventListener('click', (event) => {
          event.preventDefault();
          if (page === current) return;
          current = page;
          window.history.replaceState(null, '', withBase(`/faq?page=${encodeURIComponent(page)}`));
          highlight();
          void loadFaqPage({ ...init, page });
        });
        toc.appendChild(link);
      }
      highlight();
    };
    const highlight = (): void => {
      for (const link of Array.from(toc?.querySelectorAll<HTMLAnchorElement>('a') ?? [])) {
        const active = link.dataset.page === current;
        link.classList.toggle('font-semibold', active);
        link.classList.toggle('text-emerald-600', active);
        link.classList.toggle('dark:text-emerald-400', active);
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      }
    };

    void getFaqPages().then(renderToc);
    void loadFaqPage({ ...init, page: current });
  </script>
</BaseLayout>
