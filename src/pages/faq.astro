---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaqRoute from '@/components/routes/FaqRoute.astro';
import HashRedirect from '@/components/HashRedirect.astro';
import { HASH_ROUTER } from '@/lib/router';
---

{
  HASH_ROUTER ? (
    <HashRedirect to="/faq" />
  ) : (
    <BaseLayout titleKey="faq.title">
      <FaqRoute />
    </BaseLayout>
  )
}
