---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeRoute from '@/components/routes/HomeRoute.astro';
import SpaShell from '@/components/SpaShell.astro';
import { HASH_ROUTER } from '@/lib/router';

// hash 模式：index 即整站单页壳（全部路由挂载，# 路由激活）；
// path 模式：index 是首页落地页，动态路由由 404 SPA 回退承载
---

<BaseLayout>
  {HASH_ROUTER ? <SpaShell /> : <HomeRoute />}
</BaseLayout>
