---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewRoute from '@/components/routes/NewRoute.astro';
import HashRedirect from '@/components/HashRedirect.astro';
import { HASH_ROUTER } from '@/lib/router';
---

{
  HASH_ROUTER ? (
    <HashRedirect to="/new" />
  ) : (
    <BaseLayout titleKey="new.title">
      <NewRoute />
    </BaseLayout>
  )
}
