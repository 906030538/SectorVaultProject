---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TermsRoute from "@/components/routes/TermsRoute.astro";
import HashRedirect from "@/components/HashRedirect.astro";
import { HASH_ROUTER } from "@/lib/router";
---

{
  HASH_ROUTER ? (
    <HashRedirect to="/terms" />
  ) : (
    <BaseLayout titleKey="terms.title">
      <TermsRoute />
    </BaseLayout>
  )
}
