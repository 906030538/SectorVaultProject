---
import BaseLayout from '@/layouts/BaseLayout.astro';
import UserRoute from '@/components/routes/UserRoute.astro';
import { userStaticPaths } from '@/lib/paths';

/**
 * 动态路由 /user/:name。
 * 索引内已知用户构建期预渲染；其余用户由 404 SPA 回退客户端渲染。
 */
export async function getStaticPaths() {
  return await userStaticPaths();
}
---

<BaseLayout>
  <UserRoute />
</BaseLayout>
