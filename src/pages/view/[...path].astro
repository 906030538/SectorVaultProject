---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ViewRoute from '@/components/routes/ViewRoute.astro';
import { viewStaticPaths } from '@/lib/paths';

/**
 * 动态路由 /view/:name/:repo[/:slug]。
 * 索引内已知路径构建期预渲染；其余路径由 404 SPA 回退客户端渲染。
 */
export async function getStaticPaths() {
  return await viewStaticPaths();
}
---

<BaseLayout>
  <ViewRoute />
</BaseLayout>
