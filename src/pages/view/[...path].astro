---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ViewRoute from '@/components/routes/ViewRoute.astro';

/**
 * 动态路由 /view/:name/:repo[/:slug]。
 * 不做构建期预渲染（避免按用户/稿件生成具体页面），全部由 404 SPA 回退客户端渲染。
 */
export function getStaticPaths() {
  return [];
}
---

<BaseLayout>
  <ViewRoute />
</BaseLayout>
