---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SubmissionRoute from '@/components/routes/SubmissionRoute.astro';
import CollectionRoute from '@/components/routes/CollectionRoute.astro';

/**
 * 动态路由 /view/:name/:repo[/:slug]。
 * 不做构建期预渲染（避免按用户/稿件生成具体页面），全部由 404 SPA 回退客户端渲染。
 * 投稿详情与集合详情拆分为两个组件，按路径段数各自激活。
 */
export function getStaticPaths() {
  return [];
}
---

<BaseLayout>
  <SubmissionRoute />
  <CollectionRoute />
</BaseLayout>
